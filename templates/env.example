# Copy to .env and fill in. Never commit .env.
#
# This file holds the KEYS with empty values. It is documentation that cannot
# go stale silently: add a variable without adding it here, and the next
# person's application fails at boot naming exactly what is missing.

# --- public: safe in the browser, subject to row-level security ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- server only: NEVER prefixed NEXT_PUBLIC_ or VITE_, never in a bundle ---
# This key bypasses every row-level security policy in the database.
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=

# --- app ---
APP_URL=http://localhost:3000
